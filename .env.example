# Required
DATABASE_URL=postgres://postgres@localhost:5433/wishwell
APP_URL=http://localhost:3000
# Protects the /api/cron endpoint used by a hosted scheduler
CRON_SECRET=change-me

# Optional: AI wish writing (falls back to built-in templates when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: real email delivery (falls back to the dev outbox when unset)
RESEND_API_KEY=
EMAIL_FROM="WishWell <wishes@example.com>"

# Optional: push notifications to phones and browsers (Web Push / VAPID).
# Generate a key pair once with: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# Business WhatsApp (WhatsApp Business Platform, Cloud API)
# Required to let businesses connect WhatsApp: encrypts their access tokens. Create with: openssl rand -base64 32
ENCRYPTION_KEY=
# From your Meta app: App secret (verifies webhook signatures) and a verify token you choose
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Payments. India (INR) uses Razorpay subscriptions; everyone else (USD) uses Stripe Checkout.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Development only: a fake checkout page so plans can be tried without real payments. Ignored when live keys are set.
BILLING_TEST_MODE=

# Photo storage. Without S3_BUCKET, photos are saved on the server's disk in UPLOAD_DIR (default ./uploads).
# Any S3-compatible service works: AWS S3, Cloudflare R2, Backblaze B2 (set S3_ENDPOINT for non-AWS).
UPLOAD_DIR=
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Signs photo links (falls back to ENCRYPTION_KEY)
MEDIA_SIGNING_SECRET=

# --- Sign-in options (each is optional; buttons only appear when configured) ---
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client (Web).
#   Authorised redirect URI: ${APP_URL}/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: developer.apple.com → Identifiers → Services ID (+ a Sign in with Apple key). Needs HTTPS.
#   Return URL: ${APP_URL}/api/auth/oauth/apple/callback
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Text-message sign-in codes (Twilio). Without these, phone sign-in is hidden in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Development/testing only: show phone codes on screen instead of sending them.
SMS_DEV_CODES=
# Admins must use two-step verification. Set to 0 to relax this in local development only (ignored in production).
ADMIN_REQUIRE_2FA=

# --- Money features (TEST MODE ONLY: group gifts, fundraisers, gift cards, shop, printed cards) ---
# Off unless set to 1. Payments use a pretend checkout; no real money moves. See docs/LAUNCH.md before going live.
MONEY_FEATURES=

# ---- Deployment (docker-compose) ----
# Database (the password is required; generate with: openssl rand -hex 24)
POSTGRES_USER=blessly
POSTGRES_PASSWORD=
POSTGRES_DB=blessly
# Production only: your domain and an email for certificate notices
DOMAIN=
ACME_EMAIL=
